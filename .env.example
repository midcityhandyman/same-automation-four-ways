# Copy to .env and export, or set these in your process manager.
# Everything is optional. With no URLs set, every outbound call goes to an
# offline mock, which is how the tests and the demo run.

# Where state lives (SQLite file).
DB_PATH=leads.db

# Outbound JSON webhooks. Leave blank to use the offline mock for that port.
MESSAGING_WEBHOOK_URL=
CRM_WEBHOOK_URL=
TEAM_WEBHOOK_URL=
# Sent as "Authorization: Bearer <token>" when set. Never commit a real value.
GATEWAY_TOKEN=

# Timing rules.
LOCAL_UTC_OFFSET_HOURS=-5
SEND_WINDOW_START=8
SEND_WINDOW_END=20
DEDUPE_WINDOW_DAYS=30
MAX_ATTEMPTS=3
BACKOFF_BASE_SECONDS=2
